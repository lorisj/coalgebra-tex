
% ------------------------- Label-----------------------
\newtcbox{\deflabeltag}{%
    enhanced,
    on line,
    % baseline=(content.center),  
    % tcbox raise=0.2ex
    boxrule=0.3pt,
    top=1pt,
    bottom=0pt,
    left=4pt,
    right=4pt,
    arc=1pt,
    colback=white,
    fontupper=\ttfamily,
    coltext=green!70!black
}

\newtcbox{\defmarksmall}{enhanced,
    on line,
    boxrule=0.3pt,
    top=0.2pt,
    bottom=0.2pt,
    left=0.2pt,
    right=0.2pt,
    arc=1pt,
    colback=white,
    fontupper=\footnotesize\ttfamily,
    enlarge by=0.1mm,
    coltext=green!70!black
}


\newtcbox{\defmark}{on line,
    colback=white,
    enhanced,
    frame hidden,
    boxrule=0pt,
    arc=0pt,outer arc=0pt,
    borderline south={0.35mm}{0.25mm}{green!50!white},
    boxsep=2pt,left=0pt,right=0pt,top=2pt,bottom=2pt,
}

\newtcbox{\deftitle}{
    enhanced,
    colback=green!70!black,
    on line,
    leftrule=0pt,
    rightrule=0pt,
    top=1pt,
    bottom=1pt,
    left=0pt,
    right=1pt,
    colupper=white,
    arc=0pt,
    frame hidden
}


% -------------------------Ref------------------------
\newtcbox{\refdefNoLink}{
    enhanced,
    on line,
    tcbox raise base,
    boxrule=0.4pt,
    top=0mm,
    bottom=0mm,
    right=0mm,
    left=4mm,
    arc=1pt,
    boxsep=4pt,
    before upper={\vphantom{X}}, % keeps height stable
    colframe=green!50!black,
    coltext=green!25!black,
    colback=green!10!white,
    fontupper=\small\ttfamily,
    overlay={
            \begin{tcbclipinterior}
                \fill[green!75!blue!90!black]
                (frame.south west)
                rectangle
                ([xshift=4mm]frame.north west);
                \node[
                    text=white,
                    font=\sffamily\bfseries\tiny,
                    rotate=90,
                    anchor=center
                ]
                at ([xshift=2mm]frame.west) {DEF};
            \end{tcbclipinterior}
        }
}


% ------------------------- Actual TCOLORBOX --------------------


\NewTColorBox{definitionbox}{O{} m O{}}{
    enhanced,
    skin=enhancedmiddle,
    breakable,
    frame hidden,
    boxed title style={
            enhanced,
            % size=small,
            frame hidden,
            left=1pt,
            right=1pt,
            top=0pt,
            bottom=0pt,
            boxsep=0mm,
            opacityframe=0,
            opacityback=0,
            % colback=green!70!black,
            % leftrule=0pt,
            % rightrule=0pt,
        },
    attach boxed title to top left={xshift=1cm,yshift*=3.3mm-\tcboxedtitleheight},
    colback=white,
    leftrule=0pt,
    rightrule=0.3pt,
    top=2mm,
    bottom=1em,
    boxsep=0mm,
    borderline north={0.25mm}{0mm}{black!10!white},
    borderline south={0.25mm}{0mm}{black!10!white},
    borderline west={0.75mm}{0mm}{green},
    borderline west={0.75mm}{0.75mm}{green!50!white},
    borderline east={0.75mm}{0mm}{green!25!white},
    title={\deftitle{\textbf{Definition:} #2}},
    after title={%
            \IfBlankTF{#3}{}{%
                \hspace{2em}\hyperref[def:#3]{\deflabeltag{#3}}%
            }
        },
    #1
}








\NewTColorBox{minidefinitionbox}{O{} m O{}}{
    enhanced,
    skin=enhancedmiddle,
    breakable,
    frame hidden,
    top=2mm,
    bottom=1em,
    boxsep=0mm,
    colback=white,
    borderline north={0.25mm}{0mm}{black!20!white, dotted},
    borderline south={0.25mm}{0mm}{black!20!white, dotted},
    borderline west={0.75mm}{0mm}{green!50!white, dotted},
    borderline east={0.75mm}{0mm}{green!15!white},
    title={\defmark{#2}:\ },
    coltitle=green!70!black,
    after title={\IfBlankTF{#3}{\;}{\hfill\hyperref[def:#3]{\defmarksmall{#3}}}},
    attach title to upper,
    #1
}


% ------------------------- Final interface --------------------

\NewDocumentEnvironment{defB}{O{} m +b}{%
    \vspace{1mm}
    \IfNoValueTF{#1}{}{%
        \label{def:#1}%
    }
    \begin{definitionbox}[]{#2}[#1]
        #3
    \end{definitionbox}
    \vspace{1mm}
}{}


\NewDocumentEnvironment{defb}{O{} m +b}{%
    \vspace{1mm}
    \IfNoValueTF{#1}{}{%
        \label{def:#1}%
    }
    \begin{minidefinitionbox}[]{#2}[#1]
        #3
    \end{minidefinitionbox}
    \vspace{1mm}
}{}


\newcommand{\refdef}[1]{\hyperref[def:#1]{\refdefNoLink{#1}}\vspace{0.6em}}
