\NewTColorBox{examplebox}{O{} m O{}}{
    enhanced,
    skin=enhancedmiddle,
    breakable,
    frame hidden,
    boxed title style={
            enhanced,
            % size=small,
            frame hidden,
            left=1pt,
            right=1pt,
            top=0pt,
            bottom=0pt,
            boxsep=0mm,
            opacityframe=0,
            opacityback=0,
            % colback=green!70!black,
            % leftrule=0pt,
            % rightrule=0pt,
        },
    attach boxed title to top left={xshift=1cm,yshift*=3.3mm-\tcboxedtitleheight},
    colback=white,
    leftrule=0pt,
    rightrule=0.3pt,
    top=2mm,
    bottom=1em,
    boxsep=0mm,
    borderline north={0.25mm}{0mm}{black!10!white},
    borderline south={0.25mm}{0mm}{black!10!white},
    borderline west={0.75mm}{0mm}{violet},
    borderline west={0.75mm}{0.75mm}{violet!50!white},
    borderline east={0.75mm}{0mm}{violet!15!white},
    title={\exptitle{\textbf{Example:} #2}},
    after title={%
            \IfBlankTF{#3}{}{%
                \hspace{2em}\hyperref[exp:#3]{\explabeltag{#3}}%
            }
        },
    #1
}




\NewTColorBox{miniexamplebox}{O{} m O{}}{
    enhanced,
    breakable,
    skin=enhancedmiddle,
    breakable,
    frame hidden,
    top=2mm,
    bottom=1em,
    boxsep=0mm,
    colback=white,
    borderline north={0.25mm}{0mm}{violet!20!white, dotted},
    borderline south={0.25mm}{0mm}{violet!20!white, dotted},
    borderline west={0.75mm}{0mm}{violet!50!white, dotted},
    borderline east={0.75mm}{0mm}{violet!15!white},
    title={\expmark{#2}:\ },
    coltitle=violet!70!black,
    after title={\IfBlankTF{#3}{\;}{\hfill\hyperref[exp:#3]{\expmarksmall{#3}}}},
    attach title to upper,
    #1
}



% ------------------------- Final interface --------------------

\NewDocumentEnvironment{expB}{O{} m +b}{%
    \vspace{1mm}
    \IfNoValueTF{#1}{}{%
        \label{exp:#1}%
    }%
    \begin{examplebox}[]{#2}[#1]
        #3
    \end{examplebox}
    \vspace{1mm}
}{}


\NewDocumentEnvironment{expb}{O{} m +b}{%
    \vspace{1mm}
    \IfNoValueTF{#1}{}{%
        \label{exp:#1}%
    }
    \begin{miniexamplebox}[]{#2}[#1]
        #3
    \end{miniexamplebox}
    \vspace{1mm}
}{}

\newcommand{\refexp}[1]{\hyperref[exp:#1]{\refexpNoLink{#1}}}


