
% ------------------------- Label -----------------------------

\newtcbox{\explabeltag}{%
    enhanced,
    on line,
    % baseline=(content.center),  
    % tcbox raise=0.2ex
    boxrule=0.3pt,
    top=1pt,
    bottom=0pt,
    left=4pt,
    right=4pt,
    arc=1pt,
    colback=white,
    fontupper=\ttfamily,
    coltext=violet!70!black
}
\newtcbox{\expmarksmall}{enhanced,
    on line,
    boxrule=0.3pt,
    top=0.2pt,
    bottom=0.2pt,
    left=0.2pt,
    right=0.2pt,
    arc=1pt,
    colback=white,
    fontupper=\footnotesize\ttfamily,
    enlarge by=0.1mm,
    coltext=violet!70!black
}


\newtcbox{\expmark}{on line,
    colback=white,
    enhanced,
    frame hidden,
    boxrule=0pt,
    arc=0pt,outer arc=0pt,
    borderline south={0.35mm}{0.25mm}{violet!50!white},
    boxsep=2pt,left=0pt,right=0pt,top=2pt,bottom=2pt,
}

\newtcbox{\exptitle}{
    enhanced,
    colback=violet!60!white,
    on line,
    leftrule=0pt,
    rightrule=0pt,
    top=1pt,
    bottom=1pt,
    left=0pt,
    right=1pt,
    colupper=white,
    arc=0pt,
    frame hidden
}



% ------------------------- Ref----------------------------------

\newtcbox{\refexpNoLink}{%
    enhanced,
    on line,
    nobeforeafter,
    tcbox raise base,
    boxrule=0.4pt,
    top=0mm,
    bottom=0mm,
    right=0mm,
    left=4mm,
    arc=1pt,
    boxsep=4pt,
    before upper={\vphantom{X}}, % keeps height stable
    colframe=violet!50!black,
    coltext=violet!25!black,
    colback=violet!10!white,
    fontupper=\small\ttfamily,
    overlay={
            \begin{tcbclipinterior}
                \fill[violet!75!pink!90!black]
                (frame.south west)
                rectangle
                ([xshift=4mm]frame.north west);
                \node[
                    text=white,
                    font=\sffamily\bfseries\tiny,
                    rotate=90,
                    anchor=center
                ]
                at ([xshift=2mm]frame.west) {EXP};
            \end{tcbclipinterior}
        }
}


